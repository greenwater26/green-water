{
  "buildCommand": "npm run build:css",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/(.*)\\.webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/dist/styles.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "cf-worker"
        }
      ],
      "destination": "https://www.greenwateritalia.it/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "cf-connecting-ip"
        }
      ],
      "destination": "https://www.greenwateritalia.it/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "cf-ray"
        }
      ],
      "destination": "https://www.greenwateritalia.it/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "green-water.vercel.app"
        }
      ],
      "destination": "https://www.greenwateritalia.it/$1",
      "permanent": true
    },
    {
      "source": "/blog/erogatore-acqua-casa-culligan-alternative.html",
      "destination": "/erogatore-acqua-casa.html",
      "permanent": true
    },
    {
      "source": "/prodotti.html",
      "destination": "/depuratore-acqua-casa.html",
      "permanent": true
    },
    {
      "source": "/prodotti",
      "destination": "/depuratore-acqua-casa.html",
      "permanent": true
    },
    {
      "source": "/privati.html",
      "destination": "/depuratore-acqua-casa.html",
      "permanent": true
    },
    {
      "source": "/privati",
      "destination": "/depuratore-acqua-casa.html",
      "permanent": true
    }
  ]
}
